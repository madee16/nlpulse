# NLPulse Environment Configuration

# Application
APP_NAME=NLPulse
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=nlpulse
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nlpulse

# CORS (JSON string array)
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]
