# NLPulse Environment Configuration

# Application
APP_NAME=NLPulse
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=nlpulse
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nlpulse

# CORS (JSON string array)
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]

# Model Lifecycle Management (M3)
MODEL_DEVICE_PREFERENCE=auto          # Options: "auto", "cuda", "cpu"
MODEL_MAX_CACHED=3                    # Maximum loaded model instances in memory
MODEL_DEFAULT_CONCURRENCY=2           # Default per-model concurrent inference limit
MODEL_INFERENCE_TIMEOUT_SECONDS=30.0  # Maximum seconds before inference timeout
MODEL_ENABLE_WARMUP=false             # Pre-load models during startup if true

# Core NLP Pipelines (M4)
MODEL_SENTIMENT_ID=distilbert/distilbert-base-uncased-finetuned-sst-2-english
MODEL_NER_ID=dslim/bert-base-NER
MODEL_ZERO_SHOT_ID=valhalla/distilbart-mnli-12-1
NLP_MAX_TEXT_LENGTH=5000


